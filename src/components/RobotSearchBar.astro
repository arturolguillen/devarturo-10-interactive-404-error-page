<div data-search class="w-full max-w-lg mt-8 mb-6">
    <form id="search-form" class="relative group">
        <div
            class="absolute -inset-0.5 bg-linear-to-r from-indigo-500 to-violet-600 rounded-2xl blur-md opacity-30 group-focus-within:opacity-80 group-hover:opacity-50 transition duration-300"
        >
        </div>
        <div
            class="relative flex items-center bg-slate-900 border border-slate-700/80 rounded-xl overflow-hidden shadow-2xl focus-within:border-indigo-500 focus-within:ring-2 focus-within:ring-indigo-500/30 transition-all"
        >
            <div class="pl-4 pr-2 text-slate-500">
                <svg
                    class="w-5 h-5 text-slate-400"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                </svg>
            </div>
            <input
                type="search"
                id="search-input"
                placeholder="Search API docs, dashboards, clusters..."
                class="w-full bg-transparent py-3.5 px-2 text-sm text-slate-100 placeholder-slate-500 focus:outline-none"
                autocomplete="off"
            />
            <div class="hidden sm:flex items-center pr-2">
                <kbd
                    class="font-mono text-[11px] bg-slate-800 text-slate-400 px-2 py-1 rounded border border-slate-700"
                    >⌘K</kbd
                >
            </div>
            <button
                type="submit"
                class="m-1.5 px-4 py-2 bg-indigo-600 hover:bg-indigo-500 active:bg-indigo-700 text-white font-semibold text-xs rounded-lg transition-colors shadow-md shadow-indigo-600/30 flex items-center gap-1"
            >
                <span>Find</span>
            </button>
        </div>
    </form>

    <!-- Quick Suggested Search Chips -->
    <div
        data-search-suggestions
        class="mt-3 flex flex-wrap items-center justify-center gap-2 text-xs"
    >
        <span class="text-slate-500">Suggestions:</span>
        <button
            type="button"
            data-query="Serverless Edge APIs"
            class="px-2.5 py-1 rounded-md bg-slate-900/80 hover:bg-slate-800 text-slate-400 hover:text-indigo-300 border border-slate-800 hover:border-slate-700 transition-colors"
            >Edge APIs</button
        >
        <button
            type="button"
            data-query="Billing & Invoices"
            class="px-2.5 py-1 rounded-md bg-slate-900/80 hover:bg-slate-800 text-slate-400 hover:text-indigo-300 border border-slate-800 hover:border-slate-700 transition-colors"
            >Billing</button
        >
        <button
            type="button"
            data-query="Deploy Webhooks"
            class="px-2.5 py-1 rounded-md bg-slate-900/80 hover:bg-slate-800 text-slate-400 hover:text-indigo-300 border border-slate-800 hover:border-slate-700 transition-colors"
            >Webhooks</button
        >
        <button
            type="button"
            data-query="OAuth Auth2"
            class="px-2.5 py-1 rounded-md bg-slate-900/80 hover:bg-slate-800 text-slate-400 hover:text-indigo-300 border border-slate-800 hover:border-slate-700 transition-colors"
            >Auth2</button
        >
    </div>

    <!-- Live Search Feedback Banner -->
    <div
        id="search-alert"
        class="hidden mt-3 p-2.5 rounded-lg bg-emerald-950/60 border border-emerald-800/40 text-emerald-300 text-xs font-medium items-center justify-between"
    >
        <span id="search-alert-text">Searching indexed routes...</span>
        <button
            type="button"
            data-search-dismiss
            class="text-emerald-400 hover:text-white">×</button
        >
    </div>
</div>

<script>
    function queryMessage(before: any, query: any, after: any) {
        const match = document.createElement("strong");
        match.className = "text-white";
        match.textContent = `"${query}"`;
        return [
            document.createTextNode(before),
            match,
            document.createTextNode(after),
        ];
    }

    function initSearch() {
        const root = document.querySelector("[data-search]");
        const form = root?.querySelector("#search-form");
        const input = root?.querySelector("#search-input");
        const suggestions = root?.querySelector("[data-search-suggestions]");
        const banner = root?.querySelector("#search-alert");
        const alertText = root?.querySelector("#search-alert-text");
        const dismiss = root?.querySelector("[data-search-dismiss]");

        if (
            !(form instanceof HTMLFormElement) ||
            !(input instanceof HTMLInputElement) ||
            !(suggestions instanceof HTMLElement) ||
            !(banner instanceof HTMLElement) ||
            !(alertText instanceof HTMLElement) ||
            !(dismiss instanceof HTMLButtonElement)
        ) {
            return;
        }

        let resolveTimer = 0;

        const showAlert = (nodes: any) => {
            alertText.replaceChildren(...nodes);
            banner.classList.remove("hidden");
            banner.classList.add("flex");
        };

        const hideAlert = () => {
            banner.classList.add("hidden");
            banner.classList.remove("flex");
        };

        const handleSearch = () => {
            const query = input.value.trim();
            if (!query) return;

            showAlert(
                queryMessage("Scanning 4,821 routes for: ", query, "..."),
            );
            document.dispatchEvent(
                new CustomEvent("mascot-search", { detail: { query } }),
            );

            window.clearTimeout(resolveTimer);
            resolveTimer = window.setTimeout(() => {
                showAlert(
                    queryMessage(
                        "Found 6 docs & 2 endpoints matching ",
                        query,
                        " → Redirecting...",
                    ),
                );
            }, 1200);
        };

        form.addEventListener("submit", (event) => {
            event.preventDefault();
            handleSearch();
        });

        suggestions.addEventListener("click", (event) => {
            const target = event.target;
            if (!(target instanceof Element)) return;
            const button = target.closest("[data-query]");
            if (!(button instanceof HTMLButtonElement)) return;
            const query = button.dataset.query;
            if (!query) return;
            input.value = query;
            input.focus();
            handleSearch();
        });

        dismiss.addEventListener("click", () => {
            window.clearTimeout(resolveTimer);
            hideAlert();
        });

        window.addEventListener("keydown", (event) => {
            if (
                (event.metaKey || event.ctrlKey) &&
                event.key.toLowerCase() === "k"
            ) {
                event.preventDefault();
                input.focus();
            }
        });
    }

    initSearch();
</script>
